{
	"name": "n8n-nodes-northduty",
	"version": "0.1.1",
	"description": "n8n community node for NorthDuty: user journey monitoring (checkout, signup, login, forms) plus uptime, SSL, domain and site health checks, with alerts the moment something breaks",
	"keywords": [
		"n8n-community-node-package",
		"northduty",
		"monitoring",
		"uptime",
		"synthetic-monitoring",
		"user-journey",
		"woocommerce",
		"wordpress",
		"alerts",
		"ssl"
	],
	"license": "MIT",
	"homepage": "https://northduty.com/integrations/n8n/",
	"author": {
		"name": "NorthDuty",
		"email": "mike@northduty.com",
		"url": "https://northduty.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mike-northduty/n8n-nodes-northduty.git"
	},
	"bugs": {
		"url": "https://github.com/mike-northduty/n8n-nodes-northduty/issues"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/NorthDutyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/NorthDuty/NorthDuty.node.js",
			"dist/nodes/NorthDutyTrigger/NorthDutyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
